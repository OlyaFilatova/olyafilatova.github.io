{
  "name": "@olyafilatova.github.io/db-notes",
  "version": "1.0.0",
  "description": "Database models, migrations, etc.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typeorm": "typeorm",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert",
    "migration:show": "tsx ./node_modules/typeorm/cli.js migration:show"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.23.5",
    "typescript": "^5.7.0"
  }
}
