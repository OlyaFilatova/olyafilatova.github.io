{
  "name": "olyafilatova.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:website": "pnpm --filter @olyafilatova.github.io/website dev",
    "build": "pnpm -r build",
    "assemble": "run-s assemble:*",
    "assemble:experience": "npx tsx scripts/experience-assemble.ts",
    "assemble:thoughts": "npx tsx scripts/thoughts-assemble.ts",
    "assemble:projects": "npx tsx scripts/projects-assemble.ts",
    "lint": "pnpm --filter \"./chrome-extensions/**\" run lint .",
    "lint:fix": "pnpm --filter \"./chrome-extensions/**\" run lint . --fix",
    "generate-api-types": "run-s generate-api-types:*",
    "generate-api-types:job-postings": "npx openapi-typescript http://localhost:9001/openapi.json -o chrome-extensions/skill-highlight/extension/shared/api/job-postings.d.ts",
    "generate-api-types:skills": "npx openapi-typescript http://localhost:9002/openapi.json -o chrome-extensions/skill-highlight/extension/shared/api/skills.d.ts",
    "generate-api-types:job-skills": "npx openapi-typescript http://localhost:9004/openapi.json -o chrome-extensions/skill-highlight/extension/shared/api/job-skills.d.ts",
    "generate-api-types:skill-synonyms": "npx openapi-typescript http://localhost:9005/openapi.json -o chrome-extensions/skill-highlight/extension/shared/api/skill-synonyms.d.ts",
    "generate-api-types:service-job_parser-skills": "datamodel-codegen --url http://localhost:9002/openapi.json --input-file-type openapi --allow-private-network --output services/job_parser/generated/skills_models.py",
    "generate-api-types:service-skill_synonyms-skills": "datamodel-codegen --url http://localhost:9002/openapi.json --input-file-type openapi --allow-private-network --output services/skill_synonyms/generated/skills_models.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~26.1.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.13.0",
    "tsx": "4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@10.33.0",
  "lint-staged": {
    "packages/**/*.{js,ts,jsx,tsx}": [
      "eslint --fix"
    ]
  }
}
