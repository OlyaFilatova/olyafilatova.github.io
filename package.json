{
  "name": "olyafilatova.github.io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:website": "pnpm --filter @olyafilatova.github.io/website dev",
    "build": "pnpm -r build",
    "experience-assemble": "npx tsx scripts/experience-assemble.ts",
    "thoughts-assemble": "npx tsx scripts/thoughts-assemble.ts",
    "projects-assemble": "npx tsx scripts/projects-assemble.ts",
    "data-assemble": "pnpm run experience-assemble && pnpm run thoughts-assemble && pnpm run projects-assemble",
    "lint": "pnpm --filter \"./chrome-extensions/**\" run lint .",
    "lint:fix": "pnpm --filter \"./chrome-extensions/**\" run lint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~26.1.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "tsx": "4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@10.33.0",
  "lint-staged": {
    "packages/**/*.{js,ts,jsx,tsx}": [
      "eslint --fix"
    ]
  }
}
